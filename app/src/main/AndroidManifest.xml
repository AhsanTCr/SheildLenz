<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Offline Signature-Protected Companion Pass Bridge -->
    <permission
        android:name="com.ahsantcr.permission.APP_PASS_BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.ahsantcr.permission.APP_PASS_BRIDGE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" />
        </intent>
        <package android:name="com.ahsantcr.piqorax" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sheildlenz" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Standalone Chrome-Alternative Browser Window -->
        <activity
            android:name=".ui.browser.BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/browser_app_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.ahsan.tcr.sheildlenz.browser"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Standalone Time-Based Blocker Full-Screen Lock Activity -->
        <activity
            android:name=".timeblocker.ui.TimeBlockLockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication" />

        <!-- Foreground Protection Service -->
        <service
            android:name=".services.protection.AegisProtectionService"
            android:description="@string/service_protection_description"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Persistent 10-Hour Lockdown Watchdog Service -->
        <service
            android:name=".services.protection.AegisLockdownService"
            android:description="@string/service_lockdown_description"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces active safety device lockdown timer across app switches and restarts" />
        </service>

        <!-- Local Zero-Battery System-Wide Safe DNS Filter VpnService -->
        <service
            android:name=".services.dns.AegisSafeDnsVpnService"
            android:description="@string/service_safedns_description"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local zero-battery Safe DNS domain filtering without remote traffic logging" />
        </service>

        <!-- Android Quick Settings Shade Tile -->
        <service
            android:name=".services.protection.AegisQuickTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Foreground Application Monitor & Anti-Tamper Service -->
        <service
            android:name=".monitoring.accessibility.AegisAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device Admin Receiver for Strict Device Owner & Anti-Tamper Mode -->
        <receiver
            android:name=".security.deviceowner.AegisDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_config" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver to Restore 10-Hour Device Lockdown After Reboot -->
        <receiver
            android:name=".services.protection.AegisBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Foreground Background Download & Update Service -->
        <service
            android:name=".core.update.AegisBackgroundDownloadService"
            android:description="@string/service_download_description"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Persisted Resumable Update Pre-Download JobService -->
        <service
            android:name=".core.update.AegisUpdateResumeJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Auto-Update PackageInstaller Result Receiver -->
        <receiver
            android:name=".core.update.ApkInstallResultReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Offline Signature-Protected Companion App Pass Receiver -->
        <receiver
            android:name=".timeblocker.connector.AppPassConnectorReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.ahsantcr.permission.APP_PASS_BRIDGE">
            <intent-filter>
                <action android:name="com.ahsan.tcr.sheildlenz.ACTION_GRANT_APP_PASS" />
            </intent-filter>
        </receiver>

        <!-- Android Home Screen Widget: Shield Status & 1-Tap Browser Launch -->
        <receiver
            android:name=".widget.SheildlenzAppWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sheildlenz_appwidget_info" />
        </receiver>

        <!-- Secure FileProvider for In-App APK Update Installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
